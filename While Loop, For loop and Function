import random

# 1. Set Up the Game: Generate random number between 1 and 10
secret_number = random.randint(1, 10)

# 2. Prompt the User & Set Maximum Attempts
attempts = 3

# 3. Implement the Guessing Logic & Control Statements
while attempts > 0:
    try:
        guess = int(input("Guess the number (between 1 and 10): "))
    except ValueError:
        print("Invalid input! Please enter a whole number.")
        continue

    # Use 'continue' to skip the rest of the loop if the guess is out of range
    if guess < 1 or guess > 10:
        print("Your guess is out of range. Please guess a number between 1 and 10.")
        continue

    # Use 'break' to exit the loop when the guess is correct
    if guess == secret_number:
        print("Congratulations! You guessed the correct number.")
        break
    elif guess < secret_number:
        print("Too low. Try again.")
    else:
        print("Too high. Try again.")

    # Reduce attempt count for incorrect valid guesses
    attempts -= 1

else:
    # Use 'else' with the while loop if user runs out of attempts
    print("Better luck next time! You ran out of attempts.")

