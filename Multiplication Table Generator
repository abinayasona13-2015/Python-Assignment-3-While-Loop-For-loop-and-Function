# Step 1: Prompt user for Input
num = int(input("Enter a number to generate its multiplication table: "))

print(f"\nGenerating multiplication table for {num}...\n")

# Step 2: Generate the table using a for loop and range()
for i in range(1, 11):
    product = num * i
    print(f"{num} x {i} = {product}")

    # Step 3: Print each line in the exact format: "number x i = result"
    print(f"{num} x {i} = {product}")